CHAI_PROVIDER_MODE=mock
CHAI_LOG_LEVEL=info
CHAI_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
CHAI_BACKGROUND_ENABLED=false
CHAI_TELEMETRY_ENABLED=false
