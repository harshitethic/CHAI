{
  "name": "chai-desktop",
  "version": "0.10.1-alpha.1",
  "description": "CHAI \u2014 Chat Has Actions Inside. Stop chatting. Start doing.",
  "author": "Harshit Sharma",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/electron.mjs",
    "package": "npm run build && electron-builder --linux AppImage deb --publish never",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts/*.mjs package.json tsconfig.json eslint.config.mjs",
    "test:crash": "node tests/crash.mjs",
    "test:computer": "node tests/computer.mjs",
    "test:workspace": "node tests/workspace-electron.mjs",
    "test:documents": "tsx tests/documents.ts",
    "test:connectors": "node --import tsx tests/connectors.integration.ts",
    "test:oauth": "node --import tsx tests/oauth.integration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.3",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "build": {
    "appId": "com.harshitethic.chai",
    "productName": "CHAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Harshit Sharma <harshitethic@users.noreply.github.com>",
      "executableName": "chai",
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2",
        "libgbm1",
        "python3",
        "bubblewrap",
        "nodejs",
        "xdotool",
        "x11-utils",
        "git",
        "npm",
        "python3-venv",
        "python3-gi",
        "gir1.2-atspi-2.0"
      ],
      "recommends": [
        "xdg-desktop-portal",
        "gir1.2-gstreamer-1.0",
        "gstreamer1.0-pipewire",
        "gstreamer1.0-plugins-base",
        "gstreamer1.0-plugins-good"
      ]
    },
    "asarUnpack": [
      "dist/files.py",
      "dist/sandbox.py",
      "dist/artifacts.py",
      "dist/wayland.py",
      "dist/terminal-worker.py"
    ]
  },
  "homepage": "https://github.com/harshitethic/CHAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshitethic/CHAI.git"
  },
  "desktopName": "chai.desktop",
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
